{
  "name": "DDD Trilemma — C# / SQLite",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [
    5080,
    5081
  ],
  "portsAttributes": {
    "5080": {
      "label": "StateMachine API",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "5081": {
      "label": "Continuation API",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ],
      "settings": {
        "dotnet.defaultSolution": "DddDemo.sln"
      }
    }
  }
}
