{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "APIを起動（不変モデル）",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/Variants/Immutable/Api", "--", "--urls", "http://0.0.0.0:5080"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "APIを起動（可変モデル）",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/Variants/Mutable/Api", "--", "--urls", "http://0.0.0.0:5081"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "テストを実行",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "DddDemo.sln"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "DddDemo.sln"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
