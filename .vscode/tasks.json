{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "APIを起動",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/${input:implementation}/Api",
        "-p:StoryModel=${input:storyModel}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "テストを実行",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "DddDemo.sln",
        "-p:StoryModel=${input:storyModel}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "DddDemo.sln",
        "-p:StoryModel=${input:storyModel}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "implementation",
      "type": "pickString",
      "description": "閲覧判定の実装",
      "options": [
        "StateMachine",
        "Continuation"
      ],
      "default": "StateMachine"
    },
    {
      "id": "storyModel",
      "type": "pickString",
      "description": "ストーリーモデル",
      "options": [
        "Immutable",
        "Mutable"
      ],
      "default": "Immutable"
    }
  ]
}
